APP_NAME="فتوش الخالدية"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kuwait
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fatoosh
DB_USERNAME=root
DB_PASSWORD=

# Safe local defaults: database-backed session/cache/queue (no Redis required).
# For staging/production with Redis available, switch the three drivers below to
# redis and keep the REDIS_* keys filled.
SESSION_DRIVER=database
SESSION_LIFETIME=120
CACHE_STORE=database
QUEUE_CONNECTION=database

# Optional Redis (pre-wired; unused while drivers above stay on database)
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
# REDIS_URL=
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

ADMIN_SESSION_IDLE_MINUTES=30
CASHIER_SESSION_IDLE_MINUTES=30
