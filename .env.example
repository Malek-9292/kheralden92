APP_NAME="فتوش الخالدية"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Kuwait
APP_LOCALE=ar
APP_FALLBACK_LOCALE=en

# Staging/production: set FORCE_HTTPS=true and APP_URL=https://…
FORCE_HTTPS=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=fatoosh
DB_USERNAME=root
DB_PASSWORD=

# Safe local defaults: database-backed session/cache/queue (no Redis required).
# For staging with a dedicated Redis, switch the three drivers below to redis
# and keep the REDIS_* keys filled. Never share Redis DB indexes across envs.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
CACHE_STORE=database
QUEUE_CONNECTION=database

# Optional Redis (pre-wired; unused while drivers above stay on database).
# CACHE_STORE=redis needs the "cache" connection (REDIS_CACHE_DB).
# Client: phpredis extension OR `composer require predis/predis` + REDIS_CLIENT=predis.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1
# REDIS_URL=
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

ADMIN_SESSION_IDLE_MINUTES=30
CASHIER_SESSION_IDLE_MINUTES=30

# Render preview bootstrap (fatoosh:preview:bootstrap) — never commit real values.
# RUN_PREVIEW_SEED=true on first preview deploy; command is idempotent if left on.
RUN_PREVIEW_SEED=false
ADMIN_PHONE=
ADMIN_PASSWORD=
# Stable Print Agent device token (plain); stored hashed as KITCHEN-01.
PRINTER_TOKEN=

# Optional object storage instead of the Render disk mount on storage/app/public.
# Requires `league/flysystem-aws-s3-v3` if you switch FILESYSTEM_DISK=s3 later.
# FILESYSTEM_DISK=s3
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=
# AWS_ENDPOINT=
# AWS_URL=
# AWS_USE_PATH_STYLE_ENDPOINT=false
